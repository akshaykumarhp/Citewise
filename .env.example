# Copy to .env and fill in. .env is gitignored.

# --- required ----------------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- models ------------------------------------------------------------------
# Gemini model IDs change often. Run `python -m app.cli check` to see exactly
# which models your key can reach, then set these to one of those.
CHAT_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
# gemini-embedding-001 supports 128-3072. 768 is the documented sweet spot.
# Changing this invalidates your index - re-run `ingest --rebuild` after.
EMBEDDING_DIMENSIONS=768
TEMPERATURE=0.0

# --- chunking ----------------------------------------------------------------
# Characters, not tokens. Keep chunk_size under ~8000 chars so it stays inside
# the embedding model's 2048-token input limit.
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# --- retrieval ---------------------------------------------------------------
# hybrid = dense (semantic) + BM25 (keyword), fused by rank. dense = semantic only,
# which misses exact identifiers like ISO-27001. lexical = keyword only, which
# misses paraphrases ("vacation" vs "annual leave").
RETRIEVAL_MODE=hybrid
# Candidates fetched from EACH retriever before fusion and reranking. Retrieval is
# a recall problem: fetch wide here, narrow with the reranker.
CANDIDATE_K=20
# Chunks kept after reranking - what the model actually sees.
RETRIEVAL_K=5
# RRF damping constant. Lower = top ranks dominate more. 60 is the paper default.
RRF_K=60
DENSE_WEIGHT=1.0
LEXICAL_WEIGHT=1.0

# --- reranking ---------------------------------------------------------------
# llm           = one extra Gemini call per query, no extra dependencies (default)
# cross-encoder = local model, better and free per query, needs `pip install
#                 sentence-transformers` (pulls in torch, ~2GB)
# none          = passthrough; use it as a baseline to check reranking is helping
RERANK_BACKEND=llm
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Floor for reranked scores (0-1). 0.3 == a 3/10 from the LLM reranker.
RERANK_THRESHOLD=0.3
# Floor used when RERANK_BACKEND=none, on the cosine relevance scale instead.
RELEVANCE_THRESHOLD=0.35

# --- ingestion ---------------------------------------------------------------
EMBED_BATCH_SIZE=50
MAX_RETRIES=5

# --- chunking experiments (Phase 4) -------------------------------------------
# recursive = split on natural boundaries; fixed = blind fixed-size slices (baseline)
CHUNK_STRATEGY=recursive
# >0 turns on parent-document retrieval: embed CHUNK_SIZE children, show the model
# the PARENT_CHUNK_SIZE parent. Re-run `ingest --rebuild` after changing either.
PARENT_CHUNK_SIZE=0

# --- retrieval extras (Phase 6) - off until `make eval` says they help ----------
HYDE=false
AGENTIC_RETRIES=0

# --- vector store (Phase 5) ----------------------------------------------------
# chroma = local directory. pgvector = PostgreSQL (docker compose sets these for you)
VECTOR_BACKEND=chroma
DATABASE_URL=
# Folder `ingest` reads. The bundled demo corpus lives in ./corpus
# DATA_DIR=corpus

# --- serving (Phase 5) -----------------------------------------------------------
# Comma-separated origins allowed by CORS. Narrow this anywhere public.
ALLOWED_ORIGINS=*
# Per client IP, on /ask, /ask/stream and /ingest. 0 = unlimited.
RATE_LIMIT_PER_MINUTE=30
# When set, POST /ingest requires `Authorization: Bearer <ADMIN_TOKEN>`.
ADMIN_TOKEN=
# Reuse an answer when a new question embeds this close to a cached one. 0 = off.
ANSWER_CACHE_SIMILARITY=0.97
# USD per million tokens, for the cost estimate. Check current Gemini pricing.
INPUT_COST_PER_MTOK=0
OUTPUT_COST_PER_MTOK=0
